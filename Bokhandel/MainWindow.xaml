<Window
    x:Class="Bokhandel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Bokhandel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Lagerhantering"
    Width="1000"
    Height="500"
    Background="#b3c6cc"
    BorderBrush="DarkSlateGray"
    BorderThickness="2"
    FontFamily="Verdana Italic"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="ListView">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="DarkSlateGray" />
            <Setter Property="Background" Value="#e0e8eb" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition />
            <RowDefinition Height="10" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
        </Grid.ColumnDefinitions>
        <ListView
            Name="StoreListView"
            Grid.Row="1"
            Grid.Column="1"
            Margin="5"
            SelectionChanged="StoreListView_OnSelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Id}" Header="ButikID" />
                    <GridViewColumn DisplayMemberBinding="{Binding Butiksnamn}" Header="Butiksnamn" />
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Grid.Row="1" Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10*" />
                <RowDefinition Height="10*" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <ComboBox
                Name="BookComboBox"
                Margin="5"
                SelectionChanged="BookComboBox_OnSelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Isbn13}" />
                            <Run Text=" - " />
                            <Run Text="{Binding Titel}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock
                Name="BookDetailsTextBlock"
                Grid.Row="1"
                Margin="5"
                FontSize="12" />
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Name="AddBtn"
                        Width="120"
                        Height="35"
                        Margin="5"
                        Click="AddBtn_OnClick"
                        Content="Lägg till" />
                    <Button
                        Name="RemoveBtn"
                        Width="120"
                        Height="35"
                        Margin="5"
                        Background="DarkGray"
                        Click="RemoveBtn_OnClick"
                        Content="Ta bort" />
                </StackPanel>
                <Button
                    Name="MoveBookBtn"
                    Grid.Row="1"
                    Width="250"
                    Height="35"
                    Click="MoveBookBtn_OnClick"
                    Content="Flytta böcker" />
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Name="StorageBtn"
                        Width="120"
                        Height="35"
                        Margin="5"
                        Click="StorageBtn_OnClick"
                        Content="Hantera sortiment" />
                    <Button
                        Name="StoreBtn"
                        Width="120"
                        Height="35"
                        Margin="5"
                        Click="StoreBtn_OnClick"
                        Content="Hantera butik" />
                </StackPanel>
            </Grid>
        </Grid>
        <ListView
            Name="StorageListView"
            Grid.Row="1"
            Grid.Column="2"
            Margin="5"
            SelectionChanged="StorageListView_OnSelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Isbn}" Header="ISBN" />
                    <GridViewColumn DisplayMemberBinding="{Binding IsbnNavigation.Titel}" Header="Titel" />
                    <GridViewColumn DisplayMemberBinding="{Binding Antal}" Header="Antal" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
