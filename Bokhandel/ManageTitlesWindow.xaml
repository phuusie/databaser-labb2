<Window
    x:Class="Bokhandel.ManageTitlesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Bokhandel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Bokhandel.Views"
    Title="ManageTitlesWindow"
    Width="875"
    Height="750"
    Background="#85a3ad"
    BorderBrush="DarkSlateGray"
    BorderThickness="2"
    FontFamily="Verdana Italic"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="#f0f4f5" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Background" Value="#d1dde0" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#b3c6cc"></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2"></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition />
            <RowDefinition Height="10" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
        </Grid.ColumnDefinitions>
        <TabControl
            Grid.Row="1"
            Grid.Column="1"
            TabStripPlacement="Left"
            BorderThickness="2"
            BorderBrush="SlateGray">
            <TabItem Header="General">
                <views:GeneralView />
            </TabItem>
            <TabItem Header="Titles">
                <views:TitleView />
            </TabItem>
            <TabItem Header="Authors">
                <views:AuthorView />
            </TabItem>
            <TabItem Header="Publisher">
                <views:PublisherView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>