<UserControl
    x:Class="Bokhandel.Views.TitleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Bokhandel.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="100" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10" />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition />
            <RowDefinition Height="50" />
            <RowDefinition Height="10" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="1" FontSize="20">Lägg till böcker</Label>
            <Label Grid.Row="1">ISBN</Label>
            <TextBox
                Name="IsbnTextBox"
                Grid.Row="1"
                Grid.Column="1" />
            <Label Grid.Row="2">Titel</Label>
            <TextBox
                Name="TitleTextBox"
                Grid.Row="2"
                Grid.Column="1" />
            <Label Grid.Row="3">Språk</Label>
            <TextBox
                Name="LanguageTextBox"
                Grid.Row="3"
                Grid.Column="1" />
            <Label Grid.Row="4">Pris</Label>
            <TextBox
                Name="PriceTextBox"
                Grid.Row="4"
                Grid.Column="1" />
            <Label Grid.Row="5">Utgiven</Label>
            <DatePicker
                Name="ReleaseDateDatePicker"
                Grid.Row="5"
                Grid.Column="1"
                Margin="2" />
            <Label Grid.Row="6">Genre</Label>
            <ComboBox
                Name="GenreComboBox"
                Grid.Row="6"
                Grid.Column="1"
                Margin="2,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Genre1}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Label Grid.Row="7">Författare</Label>
            <ComboBox
                Name="AuthorComboBox"
                Grid.Row="7"
                Grid.Column="1"
                Margin="2,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Förnamn}" />
                            <Run Text="," />
                            <Run Text="{Binding Efternamn}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Label Grid.Row="8">Förlag</Label>
            <ComboBox Grid.Column="1" Grid.Row="8" Name="PublisherComboBox" Margin="2,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Namn}"></Run>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button Name="AddBtn" Click="AddBtn_OnClick">Lägg till</Button>
            <Button Name="UpdateBtn" Click="UpdateBtn_OnClick">Uppdatera</Button>
            <Button Name="ClearBtn" Click="ClearBtn_OnClick">Rensa</Button>
        </StackPanel>
        <ListView
            Name="BooksListView"
            Grid.Row="1"
            Grid.Column="2"
            Margin="5,0"
            Background="#e0e8eb"
            Foreground="Black"
            SelectionChanged="BooksListView_OnSelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding IsbnNavigation.Isbn13}" Header="ISBN" />
                    <GridViewColumn DisplayMemberBinding="{Binding IsbnNavigation.Titel}" Header="Titel" />
                    <GridViewColumn DisplayMemberBinding="{Binding Författare.Förnamn}" Header="Förnamn" />
                    <GridViewColumn DisplayMemberBinding="{Binding Författare.Efternamn}" Header="Efternamn" />
                    <GridViewColumn DisplayMemberBinding="{Binding IsbnNavigation.Språk}" Header="Språk" />
                    <GridViewColumn DisplayMemberBinding="{Binding Genre.Genre1}" Header="Genre" />
                    <GridViewColumn DisplayMemberBinding="{Binding IsbnNavigation.Pris}" Header="Pris" />
                    <GridViewColumn DisplayMemberBinding="{Binding Förlag.Namn}" Header="Förlag" />
                    <GridViewColumn DisplayMemberBinding="{Binding IsbnNavigation.Utgivningsdatum}" Header="Utigvningsdatum" />
                </GridView>
            </ListView.View>
        </ListView>
        <Button
            Grid.Row="2"
            Grid.Column="2"
            Width="Auto"
            Name="RemoveBtn" Click="RemoveBtn_OnClick">
            Radera titeln
        </Button>
    </Grid>
</UserControl>
