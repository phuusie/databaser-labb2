<UserControl
    x:Class="Bokhandel.Views.GeneralView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Bokhandel.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="750"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"></Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="IsHitTestVisible" Value="False"></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="IsEnabled" Value="False"></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="10" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="10" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="1"
                Margin="10"
                FontSize="18">
                Böcker
            </Label>
            <Label Grid.Row="2">ISBN</Label>
            <TextBox
                Name="IsbnTextBox"
                Grid.Row="2"
                Grid.Column="1" />
            <Label Grid.Row="3">Titel</Label>
            <TextBox
                Name="TitleTextBox"
                Grid.Row="3"
                Grid.Column="1" />
            <Label Grid.Row="4">Språk</Label>
            <TextBox
                Name="LanguageTextBox"
                Grid.Row="4"
                Grid.Column="1" />
            <Label Grid.Row="5">Pris</Label>
            <TextBox
                Name="PriceTextBox"
                Grid.Row="5"
                Grid.Column="1" />
            <Label Grid.Row="6">Utgiven</Label>
            <DatePicker
                Name="ReleaseDateDatePicker"
                Grid.Row="6"
                Grid.Column="1"
                Margin="2" />
            <Label Grid.Row="1">Böcker</Label>
            <ComboBox
                Name="BookComboBox"
                Grid.Row="1"
                Grid.Column="1"
                SelectionChanged="BookComboBox_OnSelectionChanged"
                IsEnabled="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Isbn13}" />
                            <Run Text=" - " />
                            <Run Text="{Binding Titel}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Label Grid.Row="7">Genre</Label>
            <StackPanel Grid.Row="7" Grid.Column="1">
                <TextBox
                    Name="GenreTextBox"
                    Height="28"
                    Margin="2" />
                <ComboBox
                    Name="GenreComboBox"
                    Height="25"
                    Margin="2"
                    SelectionChanged="GenreComboBox_OnSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Genre1}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <Label Grid.Row="8" FontSize="10">Bokinformation</Label>
            <Border
                Grid.Row="8"
                Grid.Column="1"
                Margin="5"
                BorderBrush="SlateGray"
                BorderThickness="2">
                <TextBlock Name="BookInformationtextBlock" FontSize="10" />
            </Border>
            <Label Grid.Row="9" FontSize="10">Lagerinformation</Label>
            <Border
                Grid.Row="8"
                Grid.Column="1"
                Margin="5"
                BorderBrush="SlateGray"
                BorderThickness="2">
                <TextBlock Name="StorageInformationTextBlock" FontSize="10" />
            </Border>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="130" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="1"
                Margin="10"
                FontSize="18">
                Författare
            </Label>
            <Label Grid.Row="2">Förnamn</Label>
            <TextBox
                Name="AuthorNameTextBox"
                Grid.Row="2"
                Grid.Column="1" />
            <Label Grid.Row="3">Efternamn</Label>
            <TextBox
                Name="AuthorLastnameTextBox"
                Grid.Row="3"
                Grid.Column="1" />
            <Label Grid.Row="4">Födelsedatum</Label>
            <DatePicker
                Name="AuthorBirthdateDatePicker"
                Grid.Row="4"
                Grid.Column="1"
                Margin="2" />
            <Label Grid.Row="1">Författare</Label>
            <ComboBox
                Name="AuthorComboBox"
                Grid.Row="1"
                Grid.Column="1"
                SelectionChanged="AuthorComboBox_OnSelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Förnamn}" />
                            <Run Text="," />
                            <Run Text="{Binding Efternamn}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Label Grid.Row="6" FontSize="10">Författarinformation</Label>
            <Border
                Grid.Row="6"
                Grid.Column="1"
                Margin="5"
                BorderBrush="SlateGray"
                BorderThickness="2">
                <TextBlock Name="AuthorInformationTextBlock" FontSize="10" />
            </Border>
            <Label
                Grid.Row="7"
                Grid.Column="1"
                FontSize="18">
                Förlag
            </Label>
            <Label Grid.Row="8">Förlag</Label>
            <ComboBox
                Name="PublisherComboBox"
                Grid.Row="8"
                Grid.Column="1"
                SelectionChanged="PublisherComboBox_OnSelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Namn}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Label Grid.Row="9">Förlagsnamn</Label>
            <TextBox
                Name="PublisherNameTextBox"
                Grid.Row="9"
                Grid.Column="1" />
            <Label Grid.Row="10">Webbadress</Label>
            <TextBox
                Name="PublisherSiteTextBox"
                Grid.Row="10"
                Grid.Column="1" />
            <Label Grid.Row="11">Stad</Label>
            <TextBox
                Name="PublisherCityTextBox"
                Grid.Row="11"
                Grid.Column="1" />
            <Label Grid.Row="12">Land</Label>
            <TextBox
                Name="PublisherCountryTextBox"
                Grid.Row="12"
                Grid.Column="1" />
            <Label Grid.Row="13" FontSize="10">Förlagsinformation</Label>
            <Border
                Grid.Row="13"
                Grid.Column="1"
                Margin="5"
                BorderBrush="SlateGray"
                BorderThickness="2">
                <TextBlock Name="PublisherTextBlock" FontSize="10" />
            </Border>
            <Button
                Name="ResetBtn"
                Grid.Row="15"
                Grid.Column="1"
                Width="200"
                Height="35"
                Margin="5"
                Click="ResetBtn_OnClick">
                Rensa fälten
            </Button>
        </Grid>
    </Grid>
</UserControl>
