<Window
    x:Class="Bokhandel.MoveBooksToStoreWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Bokhandel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MoveBookWindow"
    Width="850"
    Height="450"
    Background="#b3c6cc"
    BorderBrush="DarkSlateGray"
    BorderThickness="2"
    FontFamily="Verdana Italic"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="ListView">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="DarkSlateGray" />
            <Setter Property="Background" Value="#e0e8eb" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="25" />
            <RowDefinition />
            <RowDefinition Height="10" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="1" Grid.Column="1">Från butik</Label>
        <ListView
            Name="FromStoreListView"
            Grid.Row="2"
            Grid.Column="1"
            SelectionChanged="FromStoreListView_OnSelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Id}" Header="ButikID" />
                    <GridViewColumn DisplayMemberBinding="{Binding Butiksnamn}" Header="Butiksnamn" />
                </GridView>
            </ListView.View>
        </ListView>
        <Label Grid.Row="1" Grid.Column="2">Böcker</Label>
            <ListView Grid.Column="2" Name="BookListView" Grid.Row="2">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Isbn}" Header="ISBN" />
                        <GridViewColumn DisplayMemberBinding="{Binding IsbnNavigation.Titel}" Header="Titel" />
                        <GridViewColumn DisplayMemberBinding="{Binding Antal}" Header="Antal" />
                    </GridView>
                </ListView.View>
            </ListView>
        <Label Grid.Row="1" Grid.Column="3">Till butik</Label>
        <ListView
            Name="ToStoreListView"
            Grid.Row="2"
            Grid.Column="3"
            SelectionChanged="ToStoreListView_OnSelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Id}" Header="ButikID" />
                    <GridViewColumn DisplayMemberBinding="{Binding Butiksnamn}" Header="Butiksnamn" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>

